      <p class="footer-text footer-text--small">Todos los derechos reservados</p>
    </div>
  </nav>

  <!-- Main Content Area -->
  <main class="main-content" id="mainContent">

    <!-- Section: Inicio -->
    <section class="content-section active" id="section-inicio">
      <div class="hero">
        <div class="hero-badge">Plataforma de Consulta</div>
        <h2 class="hero-title">Derecho Canónico<br><span class="hero-title--accent">al alcance de todos</span></h2>
        <p class="hero-description">
          Busca entre cánones, documentos pontificios, decretos conciliares y textos académicos de la tradición jurídico-canónica.
        </p>

        <!-- Search Bar — Main Protagonist -->
        <div class="search-container" id="searchContainer">
          <div class="search-wrapper">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input
              type="search"
              class="search-input"
              id="searchInput"
              placeholder="Buscar cánones, documentos, decretos…"
              aria-label="Buscar en la base de datos jurídico-canónica"
              autocomplete="off"
            >
            <button class="search-btn" id="searchBtn" aria-label="Ejecutar búsqueda">
              Buscar
            </button>
          </div>
          <div class="search-suggestions">
            <span class="suggestion-label">Sugerencias:</span>
            <button class="suggestion-tag" data-query="leyes eclesiásticas">leyes eclesiásticas</button>
            <button class="suggestion-tag" data-query="excomunión">excomunión</button>
            <button class="suggestion-tag" data-query="costumbre">costumbre</button>
            <button class="suggestion-tag" data-query="penas">penas</button>
            <button class="suggestion-tag" data-query="dispensa">dispensa</button>
            <button class="suggestion-tag" data-query="1331">Canon 1331</button>
          </div>

          <!-- Live Search Results Dropdown -->
          <div class="search-results" id="searchResults" aria-live="polite"></div>
        </div>
      </div>

      <!-- Canon Detail Viewer (hidden by default) -->
      <div class="canon-detail" id="canonDetail" style="display:none;">
        <button class="canon-detail-back" id="canonDetailBack" aria-label="Volver a la estructura">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          <span>Volver</span>
        </button>
        <div class="canon-detail-header">
          <span class="canon-detail-badge" id="canonDetailBadge"></span>
          <h3 class="canon-detail-title" id="canonDetailTitle"></h3>
        </div>
        <div class="canon-detail-meta" id="canonDetailMeta"></div>
        <div class="canon-detail-body" id="canonDetailBody"></div>
      </div>

      <!-- Accordion: Hierarchical Structure of CIC -->
      <div class="accordion-section" id="accordionSection">
