   IUS CANONICUM — Design System & Styles
   A formal, minimal, reading-optimized interface
   =================================================================== */

/* --- Design Tokens --- */
:root {
  /* Colors — Ivory & Slate palette */
  --color-bg:            #FAF8F5;
  --color-bg-warm:       #F5F2ED;
  --color-surface:       #FFFFFF;
  --color-surface-hover: #F0EDE8;
  --color-border:        #E2DDD6;
  --color-border-light:  #EDE9E3;

  --color-navy:          #2C3E5A;
  --color-navy-dark:     #1E2D42;
  --color-navy-light:    #3D5278;
  --color-slate:         #5A6577;
  --color-slate-light:   #7A8594;
  --color-slate-muted:   #9AA3B0;

  --color-text:          #2A2A2A;
  --color-text-secondary:#5C5C5C;
  --color-text-muted:    #8A8A8A;

  --color-accent:        #3B5998;
  --color-accent-soft:   rgba(59, 89, 152, 0.08);
  --color-accent-border: rgba(59, 89, 152, 0.2);

  /* Typography */
  --font-display: 'Cormorant Garamond', 'Georgia', serif;
  --font-body:    'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

  /* Spacing */
  --sidebar-width: 280px;
  --header-height: 60px;
  --radius-sm:  6px;
  --radius-md:  10px;
  --radius-lg:  14px;
  --radius-xl:  20px;

  /* Shadows */
  --shadow-subtle:  0 1px 3px rgba(0,0,0,0.04), 0 1px 2px rgba(0,0,0,0.03);
  --shadow-card:    0 2px 8px rgba(0,0,0,0.05), 0 1px 3px rgba(0,0,0,0.04);
  --shadow-lifted:  0 8px 30px rgba(0,0,0,0.08), 0 2px 8px rgba(0,0,0,0.04);
  --shadow-search:  0 4px 20px rgba(0,0,0,0.06), 0 1px 6px rgba(0,0,0,0.04);

  /* Transitions */
  --transition-fast:   150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-base:   250ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-smooth: 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* --- Reset & Base --- */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  background-color: var(--color-bg);
  color: var(--color-text);
  line-height: 1.7;
  min-height: 100vh;
}

/* --- Mobile Header --- */
.mobile-header {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--header-height);
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  z-index: 1000;
  align-items: center;
  padding: 0 20px;
  gap: 16px;
}

.hamburger {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  width: 40px;
  height: 40px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  border-radius: var(--radius-sm);
  transition: background var(--transition-fast);
}

.hamburger:hover {
  background: var(--color-surface-hover);
}

.hamburger span {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--color-navy);
  border-radius: 2px;
  transition: all var(--transition-base);
  transform-origin: center;
}

.hamburger.active span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.hamburger.active span:nth-child(2) {
  opacity: 0;
}

.hamburger.active span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

.mobile-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.mobile-brand-icon {
  font-size: 1.25rem;
}

.mobile-brand-text {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--color-navy);
  letter-spacing: 0.01em;
}

/* --- Sidebar --- */
.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: var(--sidebar-width);
  height: 100vh;
  background: var(--color-surface);
  border-right: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  z-index: 1001;
  overflow-y: auto;
  transition: transform var(--transition-smooth);
}

.sidebar-brand {
  padding: 32px 28px 24px;
}

.brand-icon {
  font-size: 2rem;
  margin-bottom: 12px;
  display: block;
  line-height: 1;
  filter: grayscale(0.2);
}

.brand-title {
  font-family: var(--font-display);
  font-size: 1.65rem;
  font-weight: 600;
  color: var(--color-navy);
  letter-spacing: 0.01em;
  line-height: 1.2;
  margin-bottom: 4px;
}

.brand-subtitle {
  font-size: 0.78rem;
  color: var(--color-slate-muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-weight: 500;
}

.sidebar-divider {
  height: 1px;
  background: var(--color-border-light);
  margin: 0 24px;
}

/* --- Sidebar Navigation --- */
.sidebar-nav {
  list-style: none;
  padding: 16px 16px;
  flex: 1;
}

.sidebar-nav li {
  margin-bottom: 2px;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 16px;
  border-radius: var(--radius-md);
  color: var(--color-slate);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 450;
  transition: all var(--transition-fast);
  position: relative;
}

.nav-link::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%) scaleY(0);
  width: 3px;
  height: 20px;
  background: var(--color-navy);
  border-radius: 0 3px 3px 0;
  transition: transform var(--transition-base);
}

.nav-link:hover {
  background: var(--color-surface-hover);
  color: var(--color-navy);
}

.nav-link.active {
  background: var(--color-accent-soft);
  color: var(--color-navy);
  font-weight: 500;
}

.nav-link.active::before {
  transform: translateY(-50%) scaleY(1);
}

.nav-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  opacity: 0.7;
}

.nav-link.active .nav-icon,
.nav-link:hover .nav-icon {
  opacity: 1;
}

/* --- Sidebar Footer --- */
.sidebar-footer {
  padding: 20px 28px 24px;
}

.footer-text {
  font-size: 0.72rem;
  color: var(--color-text-muted);
  letter-spacing: 0.02em;
}

.footer-text--small {
  font-size: 0.68rem;
  margin-top: 2px;
}

/* --- Sidebar Overlay (Mobile) --- */
.sidebar-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(2px);
  z-index: 1000;
  opacity: 0;
  transition: opacity var(--transition-base);
}

.sidebar-overlay.active {
  display: block;
  opacity: 1;
}

/* --- Main Content --- */
.main-content {
  margin-left: var(--sidebar-width);
  min-height: 100vh;
  padding: 48px 56px 80px;
  max-width: calc(100% - var(--sidebar-width));
}

/* --- Content Sections --- */
.content-section {
  display: none;
  animation: fadeIn 0.4s ease;
}

.content-section.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* --- Hero Area --- */
.hero {
  text-align: center;
  padding: 40px 0 48px;
  max-width: 720px;
  margin: 0 auto;
}

.hero-badge {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-navy);
  background: var(--color-accent-soft);
  border: 1px solid var(--color-accent-border);
  padding: 6px 18px;
  border-radius: 100px;
  margin-bottom: 24px;
}

.hero-title {
  font-family: var(--font-display);
  font-size: 3rem;
  font-weight: 600;
  color: var(--color-navy-dark);
  line-height: 1.15;
  margin-bottom: 16px;
  letter-spacing: -0.01em;
}

.hero-title--accent {
  color: var(--color-slate-light);
  font-weight: 400;
  font-style: italic;
}

.hero-description {
  font-size: 1.05rem;
  color: var(--color-text-secondary);
  line-height: 1.7;
  max-width: 540px;
  margin: 0 auto 40px;
}

/* --- Search Bar (Protagonist) --- */
.search-container {
  max-width: 640px;
  margin: 0 auto;
}

.search-wrapper {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 6px 6px 6px 22px;
  box-shadow: var(--shadow-search);
  transition: all var(--transition-base);
  gap: 8px;
}

.search-wrapper:focus-within {
  border-color: var(--color-navy-light);
  box-shadow: var(--shadow-lifted), 0 0 0 3px rgba(44, 62, 90, 0.08);
}

.search-icon {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  color: var(--color-slate-muted);
  transition: color var(--transition-fast);
}

.search-wrapper:focus-within .search-icon {
  color: var(--color-navy);
}

.search-input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--color-text);
  padding: 12px 8px;
  min-width: 0;
}

.search-input::placeholder {
  color: var(--color-slate-muted);
  font-weight: 300;
}

.search-btn {
  flex-shrink: 0;
  background: var(--color-navy);
  color: #fff;
  border: none;
  padding: 12px 28px;
  border-radius: calc(var(--radius-xl) - 4px);
  font-family: var(--font-body);
  font-size: 0.88rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
  letter-spacing: 0.02em;
}

.search-btn:hover {
  background: var(--color-navy-dark);
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(30, 45, 66, 0.25);
}

.search-btn:active {
  transform: translateY(0);
}

/* --- Search Suggestions --- */
.search-suggestions {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
  flex-wrap: wrap;
  justify-content: center;
}

.suggestion-label {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  font-weight: 400;
}

.suggestion-tag {
  background: transparent;
  border: 1px solid var(--color-border);
  color: var(--color-slate);
  padding: 5px 14px;
  border-radius: 100px;
  font-family: var(--font-body);
  font-size: 0.78rem;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.suggestion-tag:hover {
  background: var(--color-accent-soft);
  border-color: var(--color-accent-border);
  color: var(--color-navy);
}

/* --- Cards Grid --- */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 56px;
}

.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  transition: all var(--transition-base);
  cursor: default;
}

.card:hover {
  border-color: var(--color-border);
  box-shadow: var(--shadow-card);
  transform: translateY(-2px);
}

.card-icon-wrapper {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-accent-soft);
  border-radius: var(--radius-md);
  margin-bottom: 18px;
}

.card-icon {
  width: 22px;
  height: 22px;
  color: var(--color-navy);
}

.card-title {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--color-navy-dark);
  margin-bottom: 10px;
  line-height: 1.3;
}

.card-text {
  font-size: 0.88rem;
  color: var(--color-text-secondary);
  line-height: 1.65;
}

/* --- Text Sections (Optimized for Reading) --- */
.text-section {
  max-width: 720px;
  margin: 48px auto 0;
  padding: 32px 0;
  border-top: 1px solid var(--color-border-light);
}

.text-section-title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--color-navy-dark);
  margin-bottom: 16px;
}

.text-body {
  font-size: 0.95rem;
  color: var(--color-text-secondary);
  line-height: 1.85;
  margin-bottom: 16px;
  text-align: justify;
  hyphens: auto;
}

.text-body:last-child {
  margin-bottom: 0;
}

/* --- Section Headers (Info, Contact, Resources) --- */
.section-header {
  margin-bottom: 40px;
}

.section-title {
  font-family: var(--font-display);
  font-size: 2.2rem;
  font-weight: 600;
  color: var(--color-navy-dark);
  margin-bottom: 12px;
}

.section-rule {
  width: 48px;
  height: 3px;
  background: var(--color-navy);
  border-radius: 3px;
  opacity: 0.6;
}

/* --- Info Grid --- */
.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-bottom: 16px;
}

.info-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  padding: 28px;
}

.info-card-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-navy-dark);
  margin-bottom: 14px;
}

/* --- Contact Layout --- */
.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 36px;
  align-items: start;
}

.contact-list {
  list-style: none;
  margin-top: 16px;
}

.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 14px 0;
  border-bottom: 1px solid var(--color-border-light);
  font-size: 0.9rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--color-navy);
  margin-top: 2px;
  opacity: 0.7;
}

/* --- Contact Form --- */
.contact-form {
  background: var(--color-surface);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  padding: 32px;
}

.form-group {
  margin-top: 20px;
}

.form-label {
  display: block;
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 6px;
  letter-spacing: 0.01em;
}

.form-input {
  width: 100%;
  padding: 12px 16px;
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.9rem;
  color: var(--color-text);
  background: var(--color-bg);
  transition: all var(--transition-fast);
  outline: none;
}

.form-input:focus {
  border-color: var(--color-navy-light);
  background: var(--color-surface);
  box-shadow: 0 0 0 3px rgba(44, 62, 90, 0.06);
}

.form-input::placeholder {
  color: var(--color-slate-muted);
}

.form-textarea {
  resize: vertical;
  min-height: 120px;
}

.form-submit {
  margin-top: 24px;
  width: 100%;
  padding: 13px;
  background: var(--color-navy);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
  letter-spacing: 0.02em;
}

.form-submit:hover {
  background: var(--color-navy-dark);
  box-shadow: 0 2px 8px rgba(30, 45, 66, 0.2);
}

/* --- Resources List --- */
.resources-list {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: var(--color-border-light);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.resource-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px 28px;
  background: var(--color-surface);
  text-decoration: none;
  transition: all var(--transition-fast);
  gap: 20px;
}

.resource-item:hover {
  background: var(--color-bg-warm);
}

.resource-type {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-navy);
  background: var(--color-accent-soft);
  padding: 3px 10px;
  border-radius: 4px;
  margin-bottom: 6px;
}

.resource-title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--color-navy-dark);
  margin-bottom: 4px;
}

.resource-desc {
  font-size: 0.84rem;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.resource-arrow {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--color-slate-muted);
  transition: all var(--transition-fast);
}

.resource-item:hover .resource-arrow {
  color: var(--color-navy);
  transform: translateX(4px);
}

/* --- Live Search Results --- */
.search-results {
  margin-top: 12px;
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-smooth);
}

.search-results.has-results {
  max-height: 70vh;
  overflow-y: auto;
}

.search-results-inner {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.search-result-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--color-border-light);
  cursor: pointer;
  transition: background var(--transition-fast);
}

.search-result-item:last-child {
  border-bottom: none;
}

.search-result-item:hover {
  background: var(--color-bg-warm);
}

.search-result-number {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-accent-soft);
  border-radius: var(--radius-md);
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-navy);
}

.search-result-content {
  flex: 1;
  min-width: 0;
}

.search-result-title {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-navy-dark);
  margin-bottom: 3px;
}

.search-result-excerpt {
  font-size: 0.84rem;
  color: var(--color-text-secondary);
  line-height: 1.5;
  height: auto;
  overflow: visible;
}

.search-result-tags {
  display: flex;
  gap: 6px;
  margin-top: 6px;
  flex-wrap: wrap;
}

.search-result-tag {
  font-size: 0.68rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-slate);
  background: var(--color-bg-warm);
  padding: 2px 8px;
  border-radius: 4px;
}

.search-no-results {
  padding: 24px 20px;
  text-align: center;
  color: var(--color-text-muted);
  font-size: 0.9rem;
}

.search-no-results svg {
  display: block;
  margin: 0 auto 10px;
  opacity: 0.4;
}

mark {
  background: rgba(59, 89, 152, 0.15);
  color: var(--color-navy-dark);
  padding: 1px 2px;
  border-radius: 3px;
}

/* --- Accordion (CIC Structure) --- */
.accordion-section {
  margin-top: 48px;
  max-width: 720px;
  margin-left: auto;
  margin-right: auto;
}

.accordion-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
  color: var(--color-navy);
}

.accordion-section-title {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--color-navy-dark);
}

.accordion-container {
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-border-light);
  display: flex;
  flex-direction: column;
  gap: 1px;
}

/* Libro (top-level accordion item) */
.accordion-libro {
  background: var(--color-surface);
}

.accordion-libro-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 18px 22px;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--color-navy-dark);
  transition: background var(--transition-fast);
  gap: 12px;
}

.accordion-libro-btn:hover {
  background: var(--color-bg-warm);
}

.accordion-libro-btn .libro-label {
  flex: 1;
}

.accordion-libro-btn .libro-badge {
  flex-shrink: 0;
  font-family: var(--font-body);
  font-size: 0.7rem;
  font-weight: 500;
  color: var(--color-slate-muted);
  background: var(--color-bg);
  padding: 3px 10px;
  border-radius: 100px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.accordion-chevron {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  color: var(--color-slate-muted);
  transition: transform var(--transition-base);
}

.accordion-libro.open > .accordion-libro-btn .accordion-chevron {
  transform: rotate(180deg);
}

.accordion-libro.open > .accordion-libro-btn {
  color: var(--color-navy);
  background: var(--color-accent-soft);
}

/* Libro content (titles/canons inside) */
.accordion-libro-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-smooth);
}

.accordion-libro.open > .accordion-libro-content {
  max-height: none;
  overflow: visible;
}

/* Título (nested inside a libro) */
.accordion-titulo {
  border-top: 1px solid var(--color-border-light);
}

.accordion-titulo-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 14px 22px 14px 40px;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  font-family: var(--font-body);
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--color-slate);
  transition: all var(--transition-fast);
}

.accordion-titulo-btn:hover {
  background: var(--color-bg-warm);
  color: var(--color-navy);
}

.accordion-titulo-btn .titulo-chevron {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  color: var(--color-slate-muted);
  transition: transform var(--transition-base);
}

.accordion-titulo.open > .accordion-titulo-btn .titulo-chevron {
  transform: rotate(90deg);
}

.accordion-titulo.open > .accordion-titulo-btn {
  color: var(--color-navy);
  font-weight: 600;
}

/* Canon list inside a título */
.accordion-titulo-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-smooth);
}

.accordion-titulo.open > .accordion-titulo-content {
  max-height: none;
  overflow: visible;
}

.accordion-canon-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 14px 22px 14px 58px;
  border-top: 1px solid var(--color-border-light);
  cursor: pointer;
  transition: all var(--transition-fast);
  background: var(--color-surface);
  height: auto;
}

.accordion-canon-item:hover {
  background: var(--color-accent-soft);
}

.canon-num-badge {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--color-navy);
}

.canon-preview {
  flex: 1;
  min-width: 0;
}

.canon-preview-title {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 2px;
}

.canon-preview-text {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  line-height: 1.55;
  height: auto;
  overflow: visible;
  white-space: normal;
  word-break: break-word;
}

.canon-arrow {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  color: var(--color-slate-muted);
  opacity: 0;
  transform: translateX(-4px);
  transition: all var(--transition-fast);
}

.accordion-canon-item:hover .canon-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* Empty libro placeholder */
.accordion-empty {
  padding: 16px 22px 16px 40px;
  font-size: 0.82rem;
  color: var(--color-text-muted);
  font-style: italic;
  border-top: 1px solid var(--color-border-light);
}

/* --- Canon Detail Viewer --- */
.canon-detail {
  max-width: 720px;
  margin: 0 auto;
  animation: fadeIn 0.35s ease;
}

.canon-detail-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px 8px 12px;
  background: none;
  border: 1px solid var(--color-border);
  border-radius: 100px;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--color-slate);
  transition: all var(--transition-fast);
  margin-bottom: 28px;
}

.canon-detail-back:hover {
  background: var(--color-surface);
  border-color: var(--color-navy-light);
  color: var(--color-navy);
}

.canon-detail-header {
  margin-bottom: 20px;
}

.canon-detail-badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-navy);
  background: var(--color-accent-soft);
  border: 1px solid var(--color-accent-border);
  padding: 5px 14px;
  border-radius: 100px;
  margin-bottom: 14px;
}

.canon-detail-title {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 600;
  color: var(--color-navy-dark);
  line-height: 1.2;
}

.canon-detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 28px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--color-border-light);
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.78rem;
  color: var(--color-slate);
  background: var(--color-bg-warm);
  padding: 5px 14px;
  border-radius: 100px;
  border: 1px solid var(--color-border-light);
}

.meta-chip svg {
  width: 14px;
  height: 14px;
  opacity: 0.6;
}

.canon-detail-body {
  font-family: var(--font-display);
  font-size: 1.35rem;
  line-height: 1.9;
  color: var(--color-text);
  padding: 24px 32px;
  background: var(--color-surface);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  border-left: 4px solid var(--color-navy);
  text-align: justify;
  hyphens: auto;
}

/* ===================================================================
   RESPONSIVE
   =================================================================== */

/* Tablets */
@media (max-width: 1024px) {
  .main-content {
    padding: 40px 36px 60px;
  }

  .hero-title {
    font-size: 2.5rem;
  }

  .contact-layout {
    grid-template-columns: 1fr;
  }

  .info-grid {
    grid-template-columns: 1fr;
  }
}

/* Mobile */
@media (max-width: 768px) {
  .mobile-header {
    display: flex;
  }

  .sidebar {
    transform: translateX(-100%);
  }

  .sidebar.open {
    transform: translateX(0);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.12);
  }

  .main-content {
    margin-left: 0;
    max-width: 100%;
    padding: calc(var(--header-height) + 24px) 20px 60px;
  }

  .hero {
    padding: 24px 0 32px;
  }

  .hero-title {
    font-size: 2rem;
  }

  .hero-description {
    font-size: 0.95rem;
    margin-bottom: 28px;
  }

  .search-wrapper {
    flex-direction: column;
    border-radius: var(--radius-lg);
    padding: 4px;
    gap: 0;
  }

  .search-wrapper > .search-icon {
    display: none;
  }

  .search-input {
    width: 100%;
    padding: 14px 16px;
    text-align: center;
  }

  .search-btn {
    width: 100%;
    border-radius: var(--radius-md);
    padding: 14px;
  }

  .section-title {
    font-size: 1.75rem;
  }

  .resource-item {
    padding: 18px 20px;
  }

  .resource-title {
    font-size: 1rem;
  }

  .text-section {
    margin-top: 32px;
    padding: 24px 0;
  }

  /* Accordion mobile adjustments */
  .accordion-libro-btn {
    padding: 16px 16px;
    font-size: 0.95rem;
  }

  .accordion-titulo-btn {
    padding: 12px 16px 12px 28px;
  }

  .accordion-canon-item {
    padding: 12px 16px 12px 36px;
  }

  .accordion-empty {
    padding: 14px 16px 14px 28px;
  }

  /* Canon detail mobile */
  .canon-detail-title {
    font-size: 1.5rem;
  }

  .canon-detail-body {
    font-size: 1.15rem;
    padding: 20px;
  }

  /* Search results mobile */
  .search-result-item {
    padding: 14px 16px;
  }

  .search-result-number {
    width: 40px;
    height: 40px;
    font-size: 0.95rem;
  }
}

/* Small phones */
@media (max-width: 400px) {
  .hero-title {
    font-size: 1.65rem;
  }

  .search-suggestions {
    gap: 6px;
  }

  .suggestion-tag {
    font-size: 0.72rem;
    padding: 4px 10px;
  }

  .accordion-libro-btn {
    font-size: 0.88rem;
  }
}

2����ȝ��8���
Mfile:///Users/josesanchez/.gemini/antigravity/scratch/ius-canonicum/script.js��/* ===================================================================
   IUS CANONICUM — Interactive Logic
   JSON data loading, real-time search, accordion, canon detail viewer,
   sidebar navigation, responsive menu
   =================================================================== */

document.addEventListener('DOMContentLoaded', () => {

  // --- State ---
  let dbData = null; // Loaded JSON data

  // --- DOM References ---
  const sidebar       = document.getElementById('sidebar');
  const overlay        = document.getElementById('sidebarOverlay');
  const hamburgerBtn   = document.getElementById('hamburgerBtn');
  const navLinks       = document.querySelectorAll('.nav-link');
  const sections       = document.querySelectorAll('.content-section');
  const searchInput    = document.getElementById('searchInput');
  const searchBtn      = document.getElementById('searchBtn');
  const searchResults  = document.getElementById('searchResults');
  const accordionContainer = document.getElementById('accordionContainer');
  const accordionSection   = document.getElementById('accordionSection');
  const canonDetail    = document.getElementById('canonDetail');
  const canonDetailBack = document.getElementById('canonDetailBack');
  const contactForm    = document.getElementById('contactForm');

  // =====================================================================
  // DATA LOADING
  // =====================================================================

  /**
   * Load data from the global DB_DATA constant (declared in data.js).
   * This avoids fetch/CORS issues when opening via file:// protocol.
   */
  function loadData() {
    if (typeof DB_DATA !== 'undefined') {
      dbData = DB_DATA;
    } else {
      console.error('DB_DATA not found. Make sure data.js is loaded before script.js.');
      return;
    }
    renderAccordion();
  }

  // =====================================================================
  // ACCORDION RENDERING
  // =====================================================================

  function renderAccordion() {
    if (!dbData || !accordionContainer) return;

    const html = dbData.estructura.map((libro, i) => {
      const hasTitulos = libro.titulos && libro.titulos.length > 0;
      const totalCanones = hasTitulos
        ? libro.titulos.reduce((sum, t) => sum + (t.canones ? t.canones.length : 0), 0)
        : 0;

      let innerHtml = '';

      if (hasTitulos) {
        innerHtml = libro.titulos.map(titulo => {
          const canonItems = (titulo.canones || []).map(num => {
            const canon = findCanon(num);
            if (!canon) return '';
            return `
              <div class="accordion-canon-item" data-canon="${canon.numero}" role="button" tabindex="0" aria-label="Ver Canon ${canon.numero}">
                <div class="canon-num-badge">${canon.numero}</div>
                <div class="canon-preview">
                  <div class="canon-preview-title">Canon ${canon.numero}</div>
                  <div class="canon-preview-text">${escapeHtml(canon.texto)}</div>
                </div>
                <svg class="canon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </div>
            `;
          }).join('');

          return `
            <div class="accordion-titulo">
              <button class="accordion-titulo-btn" aria-expanded="false">
                <svg class="titulo-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
                <span>${escapeHtml(titulo.nombre)}</span>
              </button>
              <div class="accordion-titulo-content">
                ${canonItems}
              </div>
            </div>
          `;
        }).join('');
      } else {
        innerHtml = `<div class="accordion-empty">Contenido aún no disponible para este libro.</div>`;
      }

      const badgeText = totalCanones > 0 ? `${totalCanones} cánon${totalCanones > 1 ? 'es' : ''}` : 'Vacío';

      return `
        <div class="accordion-libro" data-libro-index="${i}">
          <button class="accordion-libro-btn" aria-expanded="false">
            <span class="libro-label">${escapeHtml(libro.libro)}</span>
            <span class="libro-badge">${badgeText}</span>
            <svg class="accordion-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="accordion-libro-content">
            ${innerHtml}
          </div>
        </div>
      `;
    }).join('');

    accordionContainer.innerHTML = html;
    bindAccordionEvents();
  }

  function bindAccordionEvents() {
    // Libro toggles
    accordionContainer.querySelectorAll('.accordion-libro-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const libro = btn.closest('.accordion-libro');
        const isOpen = libro.classList.contains('open');

        // Close all other libros
        accordionContainer.querySelectorAll('.accordion-libro.open').forEach(el => {
          if (el !== libro) {
            el.classList.remove('open');
            el.querySelector('.accordion-libro-btn').setAttribute('aria-expanded', 'false');
          }
        });

        libro.classList.toggle('open', !isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    });

    // Título toggles
    accordionContainer.querySelectorAll('.accordion-titulo-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const titulo = btn.closest('.accordion-titulo');
        const isOpen = titulo.classList.contains('open');
        titulo.classList.toggle('open', !isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    });

    // Canon item clicks
    accordionContainer.querySelectorAll('.accordion-canon-item').forEach(item => {
      item.addEventListener('click', () => {
        const num = parseInt(item.dataset.canon, 10);
        showCanonDetail(num);
      });
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const num = parseInt(item.dataset.canon, 10);
          showCanonDetail(num);
        }
      });
    });
  }

  // =====================================================================
  // CANON DETAIL VIEWER
  // =====================================================================

  function showCanonDetail(numero) {
    const canon = findCanon(numero);
    if (!canon) return;

    // Populate detail panel
    document.getElementById('canonDetailBadge').textContent = canon.capitulo;
    document.getElementById('canonDetailTitle').textContent = `Canon ${canon.numero}`;

    // Meta chips: libro, capítulo, temas
    const metaHtml = [
      metaChip('book', canon.libro),
      ...canon.temas.map(t => metaChip('tag', t))
    ].join('');
    document.getElementById('canonDetailMeta').innerHTML = metaHtml;

    // Body text
    document.getElementById('canonDetailBody').textContent = canon.texto;

    // Show detail, hide accordion
    canonDetail.style.display = 'block';
    canonDetail.style.animation = 'none';
    canonDetail.offsetHeight; // reflow
    canonDetail.style.animation = '';
    accordionSection.style.display = 'none';

    // Scroll to top
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function hideCanonDetail() {
    canonDetail.style.display = 'none';
    accordionSection.style.display = '';
  }

  canonDetailBack.addEventListener('click', hideCanonDetail);

  function metaChip(type, text) {
    const icons = {
      book: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>`,
      tag: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>`
    };
    return `<span class="meta-chip">${icons[type] || ''}${escapeHtml(text)}</span>`;
  }

  // =====================================================================
  // REAL-TIME SEARCH
  // =====================================================================

  let searchDebounce = null;

  function performSearch() {
    const query = searchInput.value.trim();

    if (!query) {
      clearSearchResults();
      return;
    }

    if (!dbData) return;

    const results = searchCanones(query);
    renderSearchResults(results, query);
  }

  function searchCanones(query) {
    const q = normalizeStr(query);

    return dbData.canones.filter(canon => {
      // Match against canon number
      if (String(canon.numero) === q || `canon ${canon.numero}` === q || `canon${canon.numero}` === q) {
        return true;
      }

      // Match against text
      if (normalizeStr(canon.texto).includes(q)) return true;

      // Match against temas
      if (canon.temas.some(t => normalizeStr(t).includes(q))) return true;

      // Match against libro / capítulo
      if (normalizeStr(canon.libro).includes(q)) return true;
      if (normalizeStr(canon.capitulo).includes(q)) return true;

      return false;
    });
  }

  function renderSearchResults(results, query) {
    if (results.length === 0) {
      searchResults.innerHTML = `
        <div class="search-results-inner">
          <div class="search-no-results">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              <line x1="8" y1="8" x2="14" y2="14"/>
              <line x1="14" y1="8" x2="8" y2="14"/>
            </svg>
            No se encontraron resultados para «<strong>${escapeHtml(query)}</strong>»
          </div>
        </div>
      `;
      searchResults.classList.add('has-results');
      return;
    }

    const itemsHtml = results.map(canon => {
      const highlightedText = highlightMatch(canon.texto, query);
      const tagsHtml = canon.temas.map(t =>
        `<span class="search-result-tag">${highlightMatch(t, query)}</span>`
      ).join('');

      return `
        <div class="search-result-item" data-canon="${canon.numero}" role="button" tabindex="0">
          <div class="search-result-number">${canon.numero}</div>
          <div class="search-result-content">
            <div class="search-result-title">Canon ${canon.numero}</div>
            <div class="search-result-excerpt">${highlightedText}</div>
            <div class="search-result-tags">${tagsHtml}</div>
          </div>
        </div>
      `;
    }).join('');

    searchResults.innerHTML = `<div class="search-results-inner">${itemsHtml}</div>`;
    searchResults.classList.add('has-results');

    // Bind click handlers
    searchResults.querySelectorAll('.search-result-item').forEach(item => {
      item.addEventListener('click', () => {
        const num = parseInt(item.dataset.canon, 10);
        showCanonDetail(num);
        clearSearchResults();
        searchInput.value = '';
      });
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const num = parseInt(item.dataset.canon, 10);
          showCanonDetail(num);
          clearSearchResults();
          searchInput.value = '';
        }
      });
    });
  }

  function clearSearchResults() {
    searchResults.innerHTML = '';
    searchResults.classList.remove('has-results');
  }

  // Real-time input listener (debounced)
  searchInput.addEventListener('input', () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(performSearch, 150);
  });

  // Button click also triggers search
  searchBtn.addEventListener('click', () => {
    performSearch();
  });

  // Enter key triggers search
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      performSearch();
    }
    if (e.key === 'Escape') {
      clearSearchResults();
      searchInput.value = '';
      searchInput.blur();
    }
  });

  // Close results when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.search-container')) {
      clearSearchResults();
    }
  });

  // =====================================================================
  // SUGGESTION TAGS
  // =====================================================================

  document.querySelectorAll('.suggestion-tag').forEach(tag => {
    tag.addEventListener('click', () => {
      searchInput.value = tag.dataset.query;
      searchInput.focus();
      performSearch();

      // Visual feedback
      document.querySelectorAll('.suggestion-tag').forEach(t => {
        t.style.background = '';
        t.style.borderColor = '';
        t.style.color = '';
      });
      tag.style.background = 'var(--color-accent-soft)';
      tag.style.borderColor = 'var(--color-accent-border)';
      tag.style.color = 'var(--color-navy)';
    });
  });

  // =====================================================================
  // SIDEBAR NAVIGATION
  // =====================================================================

  function openSidebar() {
    sidebar.classList.add('open');
    overlay.classList.add('active');
    hamburgerBtn.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebar.classList.remove('open');
    overlay.classList.remove('active');
    hamburgerBtn.classList.remove('active');
    document.body.style.overflow = '';
  }

  hamburgerBtn.addEventListener('click', () => {
    sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
  });

  overlay.addEventListener('click', closeSidebar);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar.classList.contains('open')) {
      closeSidebar();
    }
  });

  function switchSection(sectionId) {
    navLinks.forEach(link => {
      link.classList.toggle('active', link.dataset.section === sectionId);
    });

    sections.forEach(section => {
      const isTarget = section.id === `section-${sectionId}`;
      if (isTarget && !section.classList.contains('active')) {
        section.classList.add('active');
        section.style.animation = 'none';
        section.offsetHeight;
        section.style.animation = '';
      } else if (!isTarget) {
        section.classList.remove('active');
      }
    });

    // When switching to inicio, reset canon detail view
    if (sectionId === 'inicio') {
      hideCanonDetail();
      clearSearchResults();
      searchInput.value = '';
    }

    if (window.innerWidth <= 768) closeSidebar();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      switchSection(link.dataset.section);
    });
  });

  // =====================================================================
  // CONTACT FORM (Simulated)
  // =====================================================================

  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('contactSubmitBtn');
      submitBtn.textContent = 'Enviando…';
      submitBtn.disabled = true;

      setTimeout(() => {
        submitBtn.textContent = '✓ Mensaje enviado';
        submitBtn.style.background = '#2d6a4f';
        setTimeout(() => {
          submitBtn.textContent = 'Enviar mensaje';
          submitBtn.style.background = '';
          submitBtn.disabled = false;
          contactForm.reset();
        }, 2500);
      }, 1000);
    });
  }

  // =====================================================================
  // UTILITY FUNCTIONS
  // =====================================================================

  function findCanon(numero) {
    return dbData ? dbData.canones.find(c => c.numero === numero) : null;
  }

  function normalizeStr(str) {
    return str.toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function highlightMatch(text, query) {
    if (!query) return escapeHtml(text);
    const escaped = escapeHtml(text);
    const q = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const regex = new RegExp(`(${q})`, 'gi');
    return escaped.replace(regex, '<mark>$1</mark>');
  }

  // =====================================================================
  // WINDOW RESIZE
  // =====================================================================

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (window.innerWidth > 768) closeSidebar();
    }, 100);
  });

  // =====================================================================
  // DYNAMIC KEYFRAMES
  // =====================================================================

  const style = document.createElement('style');
  style.textContent = `
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
  `;
  document.head.appendChild(style);

  // =====================================================================
  // INIT
  // =====================================================================

  loadData();

});
