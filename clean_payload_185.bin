Nfile:///Users/josesanchez/.gemini/antigravity/scratch/ius-canonicum/index.html��<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ius Canonicum — Consulta Jurídico-Canónica</title>
  <meta name="description" content="Plataforma de consulta y búsqueda de textos jurídico-canónicos. Accede al Código de Derecho Canónico, documentos pontificios y recursos académicos.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Mobile Header -->
  <header class="mobile-header" id="mobileHeader">
    <button class="hamburger" id="hamburgerBtn" aria-label="Abrir menú de navegación">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="mobile-brand">
      <span class="mobile-brand-icon">⚖</span>
      <span class="mobile-brand-text">Ius Canonicum</span>
    </div>
  </header>

  <!-- Overlay for mobile sidebar -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- Sidebar Navigation -->
  <nav class="sidebar" id="sidebar" aria-label="Navegación principal">
    <div class="sidebar-brand">
      <div class="brand-icon">⚖</div>
      <h1 class="brand-title">Ius Canonicum</h1>
      <p class="brand-subtitle">Consulta Jurídico-Canónica</p>
    </div>

    <div class="sidebar-divider"></div>

    <ul class="sidebar-nav" role="list">
      <li>
        <a href="#inicio" class="nav-link active" data-section="inicio" id="nav-inicio">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          <span>Inicio</span>
        </a>
      </li>
      <li>
        <a href="#informacion" class="nav-link" data-section="informacion" id="nav-informacion">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
          <span>Información del Proyecto</span>
        </a>
      </li>
      <li>
        <a href="#contacto" class="nav-link" data-section="contacto" id="nav-contacto">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span>Contacto</span>
        </a>
      </li>
      <li>
        <a href="#recursos" class="nav-link" data-section="recursos" id="nav-recursos">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            <line x1="8" y1="7" x2="16" y2="7"/>
