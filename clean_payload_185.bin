Lfile:///Users/josesanchez/.gemini/antigravity/scratch/ius-canonicum/merge.rb�	#!/usr/bin/env ruby
require 'json'

# Read existing data
existing = JSON.parse(File.read('data.json'))
libro1 = JSON.parse(File.read('libro1_canones.json'))

# Build Libro I títulos from the canon data
titulos_map = {}
libro1.each do |canon|
  cap = canon['capitulo']
  titulos_map[cap] ||= []
  titulos_map[cap] << canon['numero']
end

libro1_titulos = titulos_map.map { |nombre, canones| { 'nombre' => nombre, 'canones' => canones } }

# Update Libro I in estructura
existing['estructura'].each do |libro|
  if libro['libro'] == 'Libro I: De las normas generales'
    libro['titulos'] = libro1_titulos
    break
  end
end

# Prepend Libro I canons before existing canons (sorted by numero)
existing['canones'] = libro1 + existing['canones']

# Write updated data.json
File.write('data.json', JSON.pretty_generate(existing) + "\n")

# Write data.js
File.write('data.js', "const DB_DATA = #{JSON.pretty_generate(existing)};\n")

# Report
puts "Merged #{libro1.length} Libro I canons"
puts "Total canons: #{existing['canones'].length}"
puts "Libro I títulos: #{libro1_titulos.length}"
puts "data.json: #{File.size('data.json')} bytes"
puts "data.js: #{File.size('data.js')} bytes"
2��������8��"Actúa como un desarrollador web experto. Crea la interfaz principal para una aplicación web de naturaleza jurídico-canónica. El diseño debe ser formal, minimalista y limpio, pensado específicamente para lectura de textos largos, utilizando una paleta de colores sobria, amigable y no recargada (te sugiero un fondo marfil o blanco roto, con acentos en azul marino apagado o gris pizarra).

Necesito dos elementos principales en la pantalla:

Una barra lateral de navegación (sidebar) que contenga las siguientes pestañas: 'Inicio', 'Información del Proyecto', 'Contacto' y 'Recursos'.

Un área de contenido principal amplia, donde el gran protagonista sea una barra de búsqueda grande y centrada.
Haz que la estructura sea responsiva (que se vea bien tanto en computadora como en móvil). Usa datos simulados (lorem ipsum) solo para rellenar los espacios temporales."��"Excelente trabajo con la interfaz, ha quedado muy formal y profesional. Ahora vamos a darle funcionalidad al buscador y estructurar el contenido.

Por medidas de seguridad y para mantener la app estable, no harás consultas a sitios externos. Quiero que crees una base de datos local en formato JSON e integres este esquema y datos de prueba.

Modifica la página principal para que, debajo del buscador, se muestre la estructura jerárquica del Código. Usa un diseño tipo acordeón o listas desplegables.

Haz que el buscador filtre en tiempo real sobre los datos JSON que te proporciono abajo (debe buscar coincidencias en el número de canon, temas o texto).

Al seleccionar un canon de la lista o de los resultados de búsqueda, debe mostrarse el texto completo en el área central.

Aquí tienes los datos JSON que debes utilizar para construir la estructura y el buscador: {
