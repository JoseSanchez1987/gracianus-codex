
    "numero": 3,

2
0    "libro": "Libro I: De las normas generales",

>
<    "titulo": "TÍTULO PRELIMINAR: De las Normas Generales",

�
�    "texto": "Los cánones del Código no abrogan ni derogan los convenios de la Santa Sede con las naciones o con otras sociedades políticas; por tanto, estos convenios siguen en vigor como hasta ahora, sin que obsten en nada las prescripciones contrarias de este Código.",


    "temas": [


      "normas generales",


      "derecho canónico"


