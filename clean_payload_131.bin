  {


    "numero": 86,

2
0    "libro": "Libro I: De las normas generales",

f
d    "titulo": "TÍTULO IV: De los actos administrativos singulares - CAPÍTULO V: De las dispensas",

�
�    "texto": "No son dispensables las leyes que determinan los elementos constitutivos esenciales de las instituciones o de los actos jurídicos.",


    "temas": [


      "leyes eclesiásticas",


      "dispensa"
