  {


    "numero": 23,

2
0    "libro": "Libro I: De las normas generales",

.
,    "titulo": "TÍTULO II: De la costumbre",

�
�    "texto": "Tiene fuerza de ley tan sólo aquella costumbre que, introducida por una comunidad de fieles, haya sido aprobada por el legislador, conforme a los cánones que siguen.",


    "temas": [


      "costumbre",


      "leyes eclesiásticas"


