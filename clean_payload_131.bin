    "numero": 77,

2
0    "libro": "Libro I: De las normas generales",

i
g    "titulo": "TÍTULO IV: De los actos administrativos singulares - CAPÍTULO IV: De los privilegios",

�
�    "texto": "El privilegio se ha de interpretar conforme al c. 36 1; pero siempre debe interpretarse de manera que quienes lo tienen consigan realmente alguna ventaja.",


    "temas": [


      "privilegio"


    ]
