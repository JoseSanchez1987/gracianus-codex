    "numero": 18,

2
0    "libro": "Libro I: De las normas generales",

9
7    "titulo": "TÍTULO I: De las leyes eclesiásticas",

�
�    "texto": "Las leyes que establecen alguna pena, coartan el libre ejercicio de los derechos, o contienen una excepción a la ley se deben interpretar estrictamente.",


    "temas": [


      "leyes eclesiásticas"


    ]


  },


  {
