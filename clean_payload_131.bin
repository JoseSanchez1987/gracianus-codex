2
0    "libro": "Libro I: De las normas generales",

|
z    "titulo": "TÍTULO IV: De los actos administrativos singulares - CAPITULO II: De los decretos y preceptos singulares",

�
�    "texto": "El decreto singular afecta sólo a las cosas de que trata y a las personas a las que se dirige; pero las obliga en cualquier lugar, a no ser que conste otra cosa.",


    "temas": [


      "decretos"


    ]


  },
