
    "numero": 88,

2
0    "libro": "Libro I: De las normas generales",

f
d    "titulo": "TÍTULO IV: De los actos administrativos singulares - CAPÍTULO V: De las dispensas",

�
�    "texto": "El Ordinario del lugar puede dispensar de las leyes diocesanas, y, cuando considere que es en bien de los fieles, de las leyes promulgadas por el Concilio regional o provincial, o por la Conferencia Episcopal.",


    "temas": [


      "leyes eclesiásticas",


      "dispensa"
