  {


    "numero": 21,

2
0    "libro": "Libro I: De las normas generales",

9
7    "titulo": "TÍTULO I: De las leyes eclesiásticas",

�
�    "texto": "En caso de duda, no se presume la revocación de la ley precedente, sino que las leyes posteriores se han de comparar y, en la medida de lo posible, conciliarse con las anteriores.",


    "temas": [


      "leyes eclesiásticas"


    ]

