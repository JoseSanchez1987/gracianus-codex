
    "numero": 79,

2
0    "libro": "Libro I: De las normas generales",

i
g    "titulo": "TÍTULO IV: De los actos administrativos singulares - CAPÍTULO IV: De los privilegios",

�
�    "texto": "El privilegio cesa por revocación de la autoridad competente, conforme al c. 47, sin perjuicio de lo establecido en el c. 81.",


    "temas": [


      "privilegio"


    ]
